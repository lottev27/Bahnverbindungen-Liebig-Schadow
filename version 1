<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Abfahrten">
<meta name="theme-color" content="#000000">
<meta name="color-scheme" content="dark">
<title>Abfahrten</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:wght@500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --panel: #05080c;
    --frame: #1b2530;
    --head: #10202e;
    --rule: #16212b;
    --text: #f4f6f8;
    --amber: #ffb000;
    --dim: #7d8b97;
    --late: #ff6a4d;
    --font: "Barlow Semi Condensed", "Arial Narrow", system-ui, -apple-system, sans-serif;
    box-sizing: border-box;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  *, *::before, *::after { box-sizing: inherit; }
  html { background: #000; }
  body {
    margin: 0;
    background: #000;
    color: var(--text);
    font-family: var(--font);
    font-size: 18px;
    line-height: 1.15;
    -webkit-text-size-adjust: 100%;
  }
  .wrap { max-width: 640px; margin: 0 auto; padding: 10px 10px 28px; }

  /* Tafel */
  .board {
    background: var(--panel);
    border: 3px solid var(--frame);
    border-radius: 10px;
    overflow: hidden;
  }
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    background: var(--head);
    border-bottom: 2px solid var(--frame);
  }
  .topbar .title { font-size: 1.25rem; font-weight: 700; letter-spacing: .02em; }
  #clock { font-size: 1.9rem; font-weight: 700; color: var(--amber); font-variant-numeric: tabular-nums; line-height: 1; }

  .cols, .row {
    display: grid;
    grid-template-columns: 3.4rem minmax(0, 1fr) 3.6rem 3.5rem;
    column-gap: 8px;
    align-items: center;
    padding: 0 14px;
  }
  .cols {
    padding-top: 8px;
    padding-bottom: 6px;
    font-size: .85rem;
    font-weight: 600;
    color: var(--dim);
    border-bottom: 1px solid var(--frame);
  }
  .cols .t, .row .t { text-align: right; }

  .row {
    min-height: 3.6rem;
    padding-top: 7px;
    padding-bottom: 7px;
    border-bottom: 1px solid var(--rule);
    color: var(--amber);
    font-weight: 600;
  }
  .row:last-child { border-bottom: 0; }
  .row.gone { opacity: .55; }

  .badge {
    display: grid;
    place-items: center;
    min-width: 2.9rem;
    height: 2.2rem;
    padding: 0 .3rem;
    font-size: 1.35rem;
    font-weight: 700;
    color: #0a0a0a;
    background: var(--amber);
    border-radius: 4px;
  }
  .badge.bus { background: var(--text); border-radius: 999px; }

  .dest { font-size: 1.4rem; font-weight: 600; letter-spacing: .01em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .row.gone .dest { text-decoration: line-through; }

  .clock-col { text-align: right; font-size: 1.25rem; font-variant-numeric: tabular-nums; }
  .clock-col .plus { display: block; font-size: .8rem; font-weight: 700; color: var(--late); margin-top: 1px; }
  .clock-col.late { color: var(--late); }

  .mins { text-align: right; font-size: 1.7rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  .mins.now { font-size: 1.15rem; }
  .mins.cancel { font-size: .85rem; color: var(--late); line-height: 1.05; }

  .msg { padding: 14px; font-size: 1rem; font-weight: 500; color: var(--dim); }
  .msg.error { color: var(--late); }

  footer { margin: 12px 4px 0; font-size: .85rem; color: var(--dim); }
  footer.error { color: var(--late); }

  @media (max-width: 360px) {
    .cols, .row { grid-template-columns: 3rem minmax(0, 1fr) 3.2rem 3.1rem; column-gap: 6px; padding: 0 10px; }
    .dest { font-size: 1.2rem; }
    .mins { font-size: 1.5rem; }
  }
</style>
</head>
<body>
<div class="wrap">
  <div class="board">
    <div class="topbar">
      <div class="title">Abfahrten</div>
      <div id="clock" aria-label="Aktuelle Uhrzeit">--:--</div>
    </div>
    <div class="cols" aria-hidden="true">
      <div>Linie</div><div>Ziel</div><div class="t">Zeit</div><div class="t">Min</div>
    </div>
    <div id="rows" aria-live="polite"></div>
  </div>
  <footer id="status">Lade Abfahrten …</footer>
</div>

<script>
/* ---------------------------------------------------------------
   Einstellungen
   - query: Suchbegriff für die Haltestelle
   - match: Teil des Namens, an dem die richtige Haltestelle erkannt wird
   - lines: nur diese Linien anzeigen (leer = alle)
   - id:    optional feste Haltestellen-ID, dann entfällt die Suche
---------------------------------------------------------------- */
const API = 'https://v6.db.transport.rest';
const REFRESH_MS = 30000;      // Daten alle 30 Sekunden neu laden
const PER_DIRECTION = 3;       // so viele Abfahrten pro Linie und Richtung
const MAX_ROWS = 14;           // so viele Zeilen insgesamt

const STOPS = [
  { title: 'Liebigstraße',  query: 'Köln Liebigstr.',  match: 'liebig',  lines: ['5'] },
  { title: 'Schadowstraße', query: 'Köln Schadowstr.', match: 'schadow', lines: ['142'] }
];

/* --------------------------------------------------------------- */
const state = STOPS.map(() => ({ departures: null, updated: null, error: null, unfiltered: false }));
const rowsEl = document.getElementById('rows');
const statusEl = document.getElementById('status');
const clockEl = document.getElementById('clock');

const TZ = 'Europe/Berlin';
const fmtTime = d => new Date(d).toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit', timeZone: TZ });
const fmtSec  = d => new Date(d).toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit', second: '2-digit', timeZone: TZ });

function el(tag, cls, text) {
  const n = document.createElement(tag);
  if (cls) n.className = cls;
  if (text !== undefined) n.textContent = text;
  return n;
}

async function getJSON(url) {
  const res = await fetch(url, { headers: { Accept: 'application/json' } });
  if (!res.ok) throw new Error('HTTP ' + res.status);
  return res.json();
}

async function resolveStop(s) {
  if (s.id) return s.id;
  const key = 'stopid:' + s.query;
  try { const c = localStorage.getItem(key); if (c) return c; } catch (e) {}
  const url = `${API}/locations?query=${encodeURIComponent(s.query)}&results=8&stops=true&addresses=false&poi=false&language=de`;
  const r = await getJSON(url);
  const stops = (Array.isArray(r) ? r : []).filter(x => x.type === 'stop' || x.type === 'station');
  const name = x => (x.name || '').toLowerCase();
  const hit = stops.find(x => name(x).includes(s.match) && /k[öo]ln/.test(name(x)))
           || stops.find(x => name(x).includes(s.match))
           || stops[0];
  if (!hit) throw new Error('Haltestelle nicht gefunden');
  try { localStorage.setItem(key, hit.id); } catch (e) {}
  return hit.id;
}

const lineOf = d => String((d.line && d.line.name) || '').trim().split(/\s+/).pop();
const isBus  = d => /bus/i.test((d.line && (d.line.product || d.line.mode)) || '');
const dirOf  = d => String(d.direction || '').replace(/^Köln[\s,]+/i, '').trim() || 'Ziel unbekannt';
const timeOf = d => Date.parse(d.when || d.plannedWhen);
const delayMin = d => Math.round((d.delay || 0) / 60);
const minsUntil = (d, now) => Math.ceil((timeOf(d) - now) / 60000);

async function loadStop(i) {
  const s = STOPS[i];
  try {
    const id = await resolveStop(s);
    let r;
    try {
      r = await getJSON(`${API}/stops/${encodeURIComponent(id)}/departures?duration=90&results=80&remarks=false&language=de`);
    } catch (e) {
      if (!s.id) { try { localStorage.removeItem('stopid:' + s.query); } catch (e2) {} }
      throw e;
    }
    let deps = Array.isArray(r) ? r : (r.departures || []);
    let unfiltered = false;
    if (s.lines && s.lines.length) {
      const filtered = deps.filter(d => s.lines.includes(lineOf(d)));
      if (filtered.length) deps = filtered; else if (deps.length) unfiltered = true;
    }
    state[i] = { departures: deps, updated: Date.now(), error: null, unfiltered };
  } catch (e) {
    state[i].error = e.message || 'Fehler';
  }
}

async function loadAll() {
  await Promise.all(STOPS.map((_, i) => loadStop(i)));
  render();
}

/* Alle Haltestellen zu einer Liste zusammenführen:
   pro Linie und Richtung die nächsten Abfahrten, danach nach Zeit sortiert */
function mergedRows(now) {
  const perGroup = new Map();
  state.forEach((st, i) => {
    (st.departures || []).forEach(d => {
      if (!d.cancelled && timeOf(d) <= now - 30000) return;
      if (d.cancelled && Date.parse(d.plannedWhen) <= now - 30000) return;
      const key = i + '|' + lineOf(d) + '|' + dirOf(d);
      if (!perGroup.has(key)) perGroup.set(key, []);
      perGroup.get(key).push(d);
    });
  });
  let all = [];
  perGroup.forEach(list => {
    list.sort((a, b) => (timeOf(a) || Date.parse(a.plannedWhen)) - (timeOf(b) || Date.parse(b.plannedWhen)));
    all = all.concat(list.slice(0, PER_DIRECTION));
  });
  const sortT = d => d.cancelled ? Date.parse(d.plannedWhen) : timeOf(d);
  all.sort((a, b) => sortT(a) - sortT(b));
  return all.slice(0, MAX_ROWS);
}

function renderRow(d, now) {
  const gone = !!d.cancelled;
  const row = el('div', 'row' + (gone ? ' gone' : ''));
  row.appendChild(el('div', 'badge' + (isBus(d) ? ' bus' : ''), lineOf(d)));
  row.appendChild(el('div', 'dest', dirOf(d)));

  const late = gone ? 0 : delayMin(d);
  const tc = el('div', 'clock-col t' + (late >= 1 ? ' late' : ''), fmtTime(gone ? d.plannedWhen : d.when || d.plannedWhen));
  if (late >= 1) tc.appendChild(el('span', 'plus', '+' + late));
  row.appendChild(tc);

  const mins = el('div', 't mins');
  if (gone) {
    mins.className = 't mins cancel';
    mins.textContent = 'fällt aus';
  } else {
    const m = minsUntil(d, now);
    if (m <= 0) { mins.className = 't mins now'; mins.textContent = 'jetzt'; }
    else mins.textContent = String(m);
  }
  row.appendChild(mins);
  return row;
}

function render() {
  const now = Date.now();
  rowsEl.replaceChildren();

  const rows = mergedRows(now);
  const loaded = state.some(st => st.departures);
  const errors = [];
  let latest = 0;

  state.forEach((st, i) => {
    if (st.updated) latest = Math.max(latest, st.updated);
    if (st.error) errors.push(STOPS[i].title + ': ' + st.error);
    if (st.unfiltered) errors.push('Linie ' + STOPS[i].lines.join(', ') + ' nicht gefunden');
  });

  if (rows.length) {
    rows.forEach(d => rowsEl.appendChild(renderRow(d, now)));
  } else if (loaded) {
    rowsEl.appendChild(el('div', 'msg', 'Keine Abfahrten in den nächsten 90 Minuten.'));
  } else if (errors.length) {
    rowsEl.appendChild(el('div', 'msg error', 'Abfahrten konnten nicht geladen werden.'));
  } else {
    rowsEl.appendChild(el('div', 'msg', 'Lade Abfahrten …'));
  }

  statusEl.className = errors.length ? 'error' : '';
  if (errors.length) {
    statusEl.textContent = errors.join(' · ') + (latest ? ' · letzte Daten von ' + fmtTime(latest) + ' Uhr' : '');
  } else if (latest) {
    statusEl.textContent = 'Stand ' + fmtSec(latest) + ' · Verspätungen eingerechnet · aktualisiert sich automatisch';
  } else {
    statusEl.textContent = 'Lade Abfahrten …';
  }
}

let tick = 0;
setInterval(() => {
  clockEl.textContent = fmtTime(Date.now());
  if (++tick % 5 === 0) render();
}, 1000);
clockEl.textContent = fmtTime(Date.now());

setInterval(() => { if (!document.hidden) loadAll(); }, REFRESH_MS);
document.addEventListener('visibilitychange', () => { if (!document.hidden) loadAll(); });

render();
loadAll();
</script>
</body>
</html>
